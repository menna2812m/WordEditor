{
  "name": "wordeditor",
  "main": "./worker/index.ts",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist/frontend/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /api/* goes to the Worker (and on to the .NET container); everything else is served as static files.
    "run_worker_first": ["/api/*"],
  },
  "containers": [
    {
      "class_name": "Backend",
      "image": "./backend/Dockerfile",
      "max_instances": 1,
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "BACKEND", "class_name": "Backend" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Backend"] }],
}
